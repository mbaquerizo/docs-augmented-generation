{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "adapters": {
      "type": "object",
      "properties": {
        "documentation": {
          "type": "object",
          "oneOf": [
            {
              "properties": {
                "type": { "const": "local" },
                "config": { "$ref": "#/$defs/documentationConfig" }
              },
              "required": ["type"]
            },
            {
              "properties": {
                "type": { "const": "db" },
                "config": { "$ref": "#/$defs/documentationConfig" }
              },
              "required": ["type"]
            },
            {
              "properties": {
                "type": { "const": "dagger" },
                "config": { "$ref": "#/$defs/documentationConfig" }
              },
              "required": ["type"]
            }
          ]
        },
        "issue-tracking": {
          "type": "object",
          "oneOf": [
            {
              "properties": {
                "type": { "const": "local" },
                "config": { "$ref": "#/$defs/issueTrackingConfig" }
              },
              "required": ["type"]
            },
            {
              "properties": {
                "type": { "const": "db" },
                "config": { "$ref": "#/$defs/issueTrackingConfig" }
              },
              "required": ["type"]
            },
            {
              "properties": {
                "type": { "const": "dagger" },
                "config": { "$ref": "#/$defs/issueTrackingConfig" }
              },
              "required": ["type"]
            }
          ]
        }
      }
    }
  },
  "required": ["adapters"],
  "$defs": {
    "documentationConfig": {
      "type": "object",
      "properties": {
        "destination": {
          "type": "string",
          "description": "Root destination. File adapters: directory path containing the adr/pitch subdirectories. Dagger: base URL (e.g. https://api.dagger.dev)."
        },
        "project": {
          "type": ["string", "integer"],
          "description": "Project scope, adapter-interpreted. Local: unused. Dagger: internal project ID or slug (required by the dagger adapter; slugs resolve server-side once supported)."
        }
      },
      "required": ["destination"]
    },
    "issueTrackingConfig": {
      "type": "object",
      "properties": {
        "destination": {
          "type": "string",
          "description": "Where tickets live. File adapters: ticket directory (replaces ticketPath). Dagger: base URL of the tracker."
        },
        "project": {
          "type": ["string", "integer"],
          "description": "Project scope, adapter-interpreted. File adapters: display prefix used in ticket IDs (e.g. DGR in DGR-42). Dagger: internal project ID or slug."
        }
      },
      "required": ["destination", "project"]
    }
  }
}
