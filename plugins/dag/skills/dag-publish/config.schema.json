{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "adapters": {
      "type": "object",
      "properties": {
        "documentation": {
          "type": "object",
          "oneOf": [
            {
              "properties": {
                "type": { "const": "local" },
                "config": {
                  "type": "object",
                  "properties": {
                    "adrPath": { "type": "string" },
                    "pitchPath": { "type": "string" }
                  }
                }
              },
              "required": ["type"]
            },
            {
              "properties": {
                "type": { "const": "db" },
                "config": {
                  "type": "object",
                  "properties": {
                    "dbPath": {
                      "type": "string",
                      "description": "Path to the SQLite database file."
                    }
                  },
                  "required": ["dbPath"]
                }
              },
              "required": ["type"]
            }
          ]
        },
        "issue-tracking": {
          "type": "object",
          "oneOf": [
            {
              "properties": {
                "type": { "const": "local" },
                "config": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string",
                      "description": "Issue-tracking project identifier. Used as the ticket ID prefix."
                    },
                    "ticketPath": { "type": "string" }
                  },
                  "required": ["project"]
                }
              },
              "required": ["type"]
            },
            {
              "properties": {
                "type": { "const": "db" },
                "config": {
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string",
                      "description": "Issue-tracking project identifier. Used as the ticket ID prefix."
                    },
                    "dbPath": {
                      "type": "string",
                      "description": "Path to the SQLite database file."
                    }
                  },
                  "required": ["project", "dbPath"]
                }
              },
              "required": ["type"]
            }
          ]
        }
      }
    }
  },
  "required": ["adapters"]
}
